# ---- Browser build (public by design) ----
# Leave both Supabase values empty to run in "this-device" mode (no login, data stays in the browser, no AI).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_… (older projects: NEXT_PUBLIC_SUPABASE_ANON_KEY)
# Set when hosting under a sub-path, e.g. GitHub Pages at https://<user>.github.io/contentpilot
NEXT_PUBLIC_BASE_PATH=

# ---- Server secrets: set with `supabase secrets set NAME=value`. NEVER put these in the build. ----
# AI_PROVIDER=gemini            # or: anthropic
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# MONTHLY_AI_CALL_LIMIT=300     # 0 = unlimited
